# Copy this file to .env.local for local development.
# NEVER commit .env.local. On Vercel, set these in Project → Settings → Environment Variables.

# ---- Supabase (Project Settings → API) ----
# Public URL of your Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" key (or the newer "publishable" key, sb_publishable_...). Safe to expose to browsers; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. "service_role" key (or newer "secret" key, sb_secret_...). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ---- Application ----
# Full public URL of the site (no trailing slash). Used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" shows synthetic demo achievers with a DEMO banner. Set "false" in production.
NEXT_PUBLIC_DEMO_MODE=true
# Name shown in the header/footer
NEXT_PUBLIC_PORTAL_NAME=Achievers' Hall
NEXT_PUBLIC_INSTITUTION_NAME=[Institution name]
# Path or URL of the approved logo (put the file in /public). Leave empty to show the placeholder.
NEXT_PUBLIC_LOGO_URL=
# Time zone used to decide what "today" and "this week" mean
APP_TIMEZONE=Asia/Kolkata

# ---- Security ----
# SERVER ONLY. Long random secret used to hash faculty invitation codes (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVITE_CODE_SECRET=replace-with-64-hex-characters
# Optional: only allow student sign-up from this email domain (e.g. university.edu.in). Leave empty to allow any.
ALLOWED_STUDENT_EMAIL_DOMAIN=
